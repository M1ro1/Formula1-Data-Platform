# ---- Airflow ----
AIRFLOW_UID=50000
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
# python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=
AIRFLOW_ADMIN_PASSWORD=admin

# ---- Postgres DB ----
DB_USER=user
DB_PASSWORD=password
DB_NAME=name

# ---- Snowflake ----
# Account identifier, format: <orgname>-<account_name>
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=F1_LOADER
SNOWFLAKE_WAREHOUSE=F1_WH
SNOWFLAKE_DATABASE=F1_DWH
SNOWFLAKE_SCHEMA=RAW

# ---- Jolpica-F1 API ----
F1_API_BASE_URL=https://api.jolpi.ca/ergast/f1
# Minimum pause between requests, seconds. Check the API docs for current limits.
F1_API_MIN_INTERVAL=0.5

# ---- Raw-file archive (S3-compatible: local MinIO now, real S3 later by changing the endpoint) ----
ARCHIVE_ENABLED=true
ARCHIVE_ENDPOINT_URL=http://minio:9000
ARCHIVE_BUCKET=f1-raw
# Also used as the MinIO root user/password; the password must be at least 8 characters. Change them.
ARCHIVE_ACCESS_KEY=f1minio
ARCHIVE_SECRET_KEY=f1minio-secret
ARCHIVE_REGION=us-east-1

